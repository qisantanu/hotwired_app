<div class='signin-section'>
  <header class="signin-section_header">
    <h4>Welcome back!</h4>
    <p class="user-login-block_info">Enter your informations below to login</p>
  </header>
  <%= form_tag signin_path do %>
    <%= email_field_tag :email, nil, placeholder: 'Enter your email' %>
    
    <div data-controller="password-visibility">
      <input type="password" data-password-visibility-target="input" name="password" id="password" />

      <button type="button" data-action="password-visibility#toggle">
        <span data-password-visibility-target="icon" class="icon-eye"></span>
        <span data-password-visibility-target="icon" class="hidden icon-eye-slash"></span>
      </button>
    </div>
    <%= submit_tag "Sign in" %>
  <% end %>
</div>